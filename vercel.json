    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!.*\\.).*)",
      "dest": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "https://blog.videotext.io/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "https://blog.videotext.io/:path*",
      "permanent": true
    }
  ]
}
