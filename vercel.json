      "dest": "/youtube-transcript-generator",
      "status": 301
    },
    {
      "src": "/batch-process",
      "dest": "/video-to-transcript",
      "status": 301
    },
    {
      "src": "/zoom-meeting-transcript",
      "dest": "/video-to-transcript",
      "status": 301
    },
    {
      "src": "/zoom-recording-transcript",
      "dest": "/video-to-transcript",
      "status": 301
    },
    {
      "src": "/google-meet-transcription",
