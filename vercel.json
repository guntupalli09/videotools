{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/embed/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"service-doc\", </.well-known/oauth-authorization-server>; rel=\"oauth-authorization-server\", </.well-known/oauth-protected-resource>; rel=\"oauth-protected-resource\", </auth.md>; rel=\"auth-md\", </.well-known/mcp/server-card.json>; rel=\"mcp-server-card\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\""
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/podcast-transcript",
      "dest": "/podcast-transcription",
      "status": 301
    },
    {
      "src": "/transcribe-podcast",
      "dest": "/podcast-transcription",
      "status": 301
    },
    {
      "src": "/podcast-to-text",
      "dest": "/podcast-transcription",
      "status": 301
    },
    {
      "src": "/podcast-to-transcript",
      "dest": "/podcast-transcription",
      "status": 301
    },
    {
      "src": "/convert-podcast-to-text",
      "dest": "/podcast-transcription",
      "status": 301
    },
    {
      "src": "/meeting-transcript",
      "dest": "/meeting-transcription",
      "status": 301
    },
    {
      "src": "/transcribe-meeting",
      "dest": "/meeting-transcription",
      "status": 301
    },
    {
      "src": "/meeting-to-text",
      "dest": "/meeting-transcription",
      "status": 301
    },
    {
      "src": "/meeting-to-transcript",
      "dest": "/meeting-transcription",
      "status": 301
    },
    {
      "src": "/interview-transcript",
      "dest": "/interview-transcription",
      "status": 301
    },
    {
      "src": "/interview-to-text",
      "dest": "/interview-transcription",
      "status": 301
    },
    {
      "src": "/interview-to-transcript",
