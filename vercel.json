      "status": 301
    },
    {
      "src": "/webinar-transcription",
      "dest": "/webinar-transcript",
      "status": 301
    },
    {
      "src": "/webinar-to-text",
      "dest": "/webinar-transcript",
      "status": 301
    },
    {
      "src": "/webinar-to-transcript",
      "dest": "/webinar-transcript",
      "status": 301
    },
    {
      "src": "/lecture-transcript",
      "dest": "/lecture-transcription",
      "status": 301
    },
    {
      "src": "/lecture-to-text",
      "dest": "/lecture-transcription",
      "status": 301
    },
    {
